# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=backend_instagram
DB_USERNAME=root
DB_PASSWORD=

# JWT Configuration
JWT_BASE64_SECRET=replace_with_a_random_base64_secret
JWT_TOKEN_VALIDITY_SECONDS=1000000000
JWT_REFRESH_TOKEN_VALIDITY_SECONDS=1000000000

# Gemini API (IMPORTANT: Replace with your own key)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-2.0-flash:generateContent

# AWS S3 Configuration
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=your-bucket-name

# Server Configuration
SERVER_PORT=8081
